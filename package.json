{
  "name": "wfhelper",
  "version": "0.0.0",
  "description": "Warframe companion: inventory, foundry, relic and riven scanning, market orders.",
  "main": ".electron-build/main.js",
  "desktopName": "wfhelper.desktop",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/bundle-preloads.js",
    "start": "pnpm run build && electron .",
    "dev": "pnpm run build:main && concurrently -k \"pnpm:dev:main\" \"pnpm:dev:preloads\" \"pnpm:dev:renderer\" \"pnpm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preloads": "node scripts/bundle-preloads.js --watch",
    "dev:renderer": "vite build --watch",
    "dev:electron": "wait-on .electron-build/main.js renderer/dist/index.html && nodemon --watch .electron-build --watch renderer --ext js,json,html,css --exec electron .",
    "dist": "pnpm run verify:onnx-models && pnpm run build && electron-builder",
    "dist:win": "pnpm run verify:onnx-models && pnpm run build && electron-builder --win nsis",
    "dist:linux": "pnpm run verify:onnx-models && pnpm run build && node scripts/build-layer-shell.mjs --require && electron-builder --linux AppImage",
    "build:layer-shell": "node scripts/build-layer-shell.mjs",
    "verify:onnx-models": "node scripts/verify-onnx-models.mjs",
    "check": "svelte-check --tsconfig tsconfig.json",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:main",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "rebuild": "electron-rebuild -f"
  },
  "keywords": [
    "warframe",
    "companion",
    "inventory"
  ],
  "author": "WFHelper",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "concurrently": "^9.2.4",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "knip": "^6.9.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.4",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@napi-rs/system-ocr": "1.0.2",
    "@wfcd/items": "^1.1276.6",
    "chokidar": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "koffi": "^2.15.1",
    "lzma": "^2.3.2",
    "ms": "2.1.3",
    "onnxruntime-node": "^1.24.3",
    "sharp": "^0.35.4",
    "warframe-public-export-plus": "^0.6.8",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.4",
    "@img/sharp-libvips-linux-x64": "1.3.3"
  },
  "build": {
    "appId": "com.wfhelper.app",
    "productName": "WFHelper",
    "directories": {
      "output": "release"
    },
    "files": [
      ".electron-build/**/*",
      "!.electron-build/**/*.map",
      "native/layer-shell/build/*.node",
      "renderer/**/*",
      "assets/**/*",
      "src/data/itemNames/**/*",
      "src/data/dojoResearch.json",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,tests,__tests__,example,examples,docs,doc}/**",
      "!node_modules/onnxruntime-node/bin/**/libonnxruntime_providers_cuda.so",
      "!node_modules/onnxruntime-node/bin/**/libonnxruntime_providers_tensorrt.so",
      "!node_modules/**/*.map",
      "!renderer/dist/**/*.map",
      "!renderer/dist/**/*.js.map",
      "!node_modules/**/*.md",
      "!node_modules/**/electron/**",
      "!node_modules/**/electron-builder/**",
      "!node_modules/**/app-builder-bin/**",
      "!node_modules/**/typescript/**",
      "!node_modules/**/vitest/**",
      "!node_modules/**/vite/**",
      "!node_modules/**/prettier/**",
      "!node_modules/**/eslint/**",
      "!node_modules/**/playwright*/**",
      "!node_modules/**/@playwright/**",
      "!node_modules/**/svelte-check/**",
      "!node_modules/@wfcd/items/data/json/i18n.json",
      "!node_modules/@wfcd/items/data/json/i18n/**",
      "!node_modules/@wfcd/items/data/json/{Enemy,Glyphs,Node,Quests,Railjack,SentinelWeapons,Sigils,Skins}.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@img/**/*",
      "native/layer-shell/build/*.node"
    ],
    "extraResources": [
      {
        "from": "scripts/warframe-watcher.ps1",
        "to": "scripts/warframe-watcher.ps1"
      },
      {
        "from": "resources/riven-ocr",
        "to": "riven-ocr"
      },
      {
        "from": "scripts/ocr-server.ps1",
        "to": "scripts/ocr-server.ps1"
      },
      {
        "from": "scripts/ocr.ps1",
        "to": "scripts/ocr.ps1"
      }
    ],
    "afterPack": "scripts/verify-packaged-runtime-assets.cjs",
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/logo.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "de_DE",
        "zh_CN"
      ],
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeaderIcon": "assets/logo.ico",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "WFHelper",
      "shortcutName": "WFHelper",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WFHelper",
        "repo": "WFHelper",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WFHelper/WFHelper.git"
  },
  "bugs": {
    "url": "https://github.com/WFHelper/WFHelper/issues"
  },
  "homepage": "https://github.com/WFHelper/WFHelper#readme"
}
